# FastAPI
# APP_NAME="Robot Dev Team Webhook Listener"
APP_HOST=127.0.0.1
APP_PORT=8888
APP_LOG_LEVEL=INFO

# Webhook secret shared with GitLab project settings (leave blank to disable)
GITLAB_WEBHOOK_SECRET=

# GitLab instance hostname.  Must match the hostname in webhook-provided clone
# URLs (i.e. the hostname part of GITLAB_EXTERNAL_URL in gitlab/.env).
# For local Docker deployments: host.docker.internal
# For production: your GitLab domain (e.g. gitlab.example.com)
GLAB_HOST=host.docker.internal

# API host including port if non-standard (defaults to GLAB_HOST on port 443/80).
# Required when GitLab is on a non-standard port (e.g. local Docker on 8929).
GLAB_API_HOST=host.docker.internal:8929

# Protocol for GitLab API and git operations: https (default) or http.
# Set to http for local deployments without TLS.
GLAB_PROTOCOL=http

# Token for glab CLI used by the app process for enrichment and auto-unassign.
# Requires `api` scope when ENABLE_AUTO_UNASSIGN is enabled (to modify assignees).
# If auto-unassign is disabled, `read_api` scope is sufficient.
GLAB_TOKEN=

# Path to routing configuration (override to use a local routes file)
# ROUTE_CONFIG_PATH=config/routes.local.yaml

# Directory for prompt templates used by agent dispatch
# PROMPT_DIR=prompts

# Directory where agent run logs are written
# RUN_LOGS_DIR=run-logs

# Optional: turn on route hot reloading
DEBUG_RELOAD_ROUTES=false

# Timeout for glab CLI subprocess calls (seconds)
# GLAB_TIMEOUT_SECONDS=30

# Agent execution timeouts
# Wall-clock: hard upper bound on total run duration (seconds)
AGENT_MAX_WALL_CLOCK_SECONDS=7200
# Inactivity: watchdog resets on stdout output only (seconds)
AGENT_MAX_INACTIVITY_SECONDS=900
# Grace period: SIGTERM before SIGKILL on timeout (seconds)
AGENT_TIMEOUT_GRACE_SECONDS=10

# Agents to notify when @all/@agents is used (comma-separated)
# To opt an optional instance in, append its GitLab username here AFTER uncommenting
# the matching `mention-*` route in config/routes.yaml -- otherwise @all/@agents
# will silently no-op for that agent (the mention expander only fans out; the
# dispatch still requires a matching `mention-*` route). Example:
# ALL_MENTIONS_AGENTS=claude,gemini,codex,opencode-kimi,grok,nemotron
ALL_MENTIONS_AGENTS=claude,gemini,codex

# Randomize agent call order for @all/@agents mentions (true/false). Only
# applies to @all/@agents expansion; explicitly listed agents stay in order.
RANDOMIZE_ALL_MENTIONS=true

# Enable the live dashboard UI (true/false)
LIVE_DASHBOARD_ENABLED=true

# Log pruning
LOG_PRUNING_ENABLED=true
LOG_RETENTION_DAYS=7
LOG_PRUNING_INTERVAL_HOURS=24

# Branch pruning (auto-remove remote branches merged into base branch)
BRANCH_PRUNING_ENABLED=false
BRANCH_PRUNING_INTERVAL_HOURS=24
BRANCH_PRUNING_DRY_RUN=true
BRANCH_PRUNING_BASE_BRANCH=main
BRANCH_PRUNING_PROTECTED_PATTERNS=main,master,HEAD,backup/*
BRANCH_PRUNING_AGENT=claude
BRANCH_PRUNING_MIN_AGE_HOURS=24

# Default agent models
CLAUDE_MODEL=claude-opus-5
# Note: the Antigravity CLI (`agy`, >= 1.1.5) accepts the stable model slugs
# printed by `agy models` (for example `gemini-3.6-flash-high`). The slug bakes
# the reasoning-effort tier into the identifier, needs no quoting, and matches
# the plain identifier style every other agent here uses. Builds older than
# 1.1.5 understand only the friendly form ("Gemini 3.6 Flash (High)"), which
# newer builds still accept for backward compatibility.
# To list the names your account can actually use (the set is fetched per
# account, so it may differ from the example below):
#   docker compose exec -u appuser app agy models   # containerized deployments
#   agy models                                      # local installs
# `agy` validates this value: an unrecognized name aborts the run with exit 1
# and prints the models your account can use.
GEMINI_MODEL=gemini-3.6-flash-high
CODEX_MODEL=gpt-5.6-sol
# The optional harnesses (OpenCode, Goose, Grok Build, Pi) are disabled by default;
# each one's model (OPENCODE_KIMI_MODEL, GOOSE_GEMMA_MODEL, GROK_MODEL,
# PI_NEMOTRON_MODEL) is defined with its identity block below, alongside the
# commented routes in config/routes.yaml.

# Project repositories mount path is configured directly in docker-compose.yml.
# Edit the volume mounts for /work/projects and /work/projects-ro to point to your
# projects directory. Projects should be organized as: <namespace>/<project-name>

# Enable on-demand repository cloning when a webhook arrives for a project
# that doesn't exist locally. Requires agent GitLab tokens to be configured.
ENABLE_AUTO_CLONE=true

# Clone depth for auto-cloned repositories.
# 0 = full history (recommended for agents that need git log/blame)
# 1+ = shallow clone (faster initial clone, limited history)
AUTO_CLONE_DEPTH=0

# Enable automatic branch switching before agent dispatch.
# When enabled, the system will:
# - For MR events: checkout the source branch
# - For issues with linked MRs: checkout the MR's source branch
# - For new issues (no MR): checkout the default branch (usually main)
# If uncommitted changes exist, they are backed up to a timestamped branch
# and pushed to origin before switching.
ENABLE_BRANCH_SWITCH=true

# Enable smart branch selection for issue/note events (default: true).
# When enabled, uses GitLab's closes_issues API to prefer MRs that explicitly
# close the current issue, avoiding false positives from mention-only links.
# When disabled, falls back to the original "first linked open MR" behavior.
ENABLE_SMART_BRANCH_SELECTION=true

# Automatically unassign agent after successful task completion
# when the task was triggered by agent assignment (default: false)
ENABLE_AUTO_UNASSIGN=true

# Dispatch an agent's read-write assign_work route immediately when an issue is
# CREATED with that agent already assigned, instead of first running readonly
# triage/review (default: true). The assign route takes precedence over
# issue-triage on creation, so it is an either/or: a pre-assigned agent skips
# triage and goes straight to work. Set to false to revert creation events to
# triage; assigning an agent to an EXISTING issue via /assign is unaffected.
ENABLE_ASSIGN_ON_ISSUE_CREATION=true

# Post a GitLab comment when an auto-backup branch is created
# during branch resolution (default: true)
ENABLE_BACKUP_NOTIFICATIONS=true

# Hold window (seconds) for mention-triggered dispatches. If an assignment
# webhook for the same agent+project+IID arrives within this window, the
# mention is suppressed to avoid duplicate responses. Set to 0 to disable.
MENTION_HOLD_SECONDS=3.0

# Agent-specific GitLab tokens and identities (used by glab-usr).
# Naming convention: for agent "foo-bar", use FOO_BAR_AGENT_GITLAB_TOKEN, etc.
# See docs/ADDING_AN_AGENT.md for the full onboarding guide.
#
# *_AGENT_GIT_EMAIL must NOT end in @example.com -- glab-usr refuses to
# authenticate with the placeholder domain to prevent commits being landed
# with fake authorship. Replace `your-org.tld` below with your real domain.
CLAUDE_AGENT_GITLAB_TOKEN=
CLAUDE_AGENT_GIT_NAME="Claude Agent"
CLAUDE_AGENT_GIT_EMAIL=claude@your-org.tld

GEMINI_AGENT_GITLAB_TOKEN=
GEMINI_AGENT_GIT_NAME="Gemini Agent"
GEMINI_AGENT_GIT_EMAIL=gemini@your-org.tld

CODEX_AGENT_GITLAB_TOKEN=
CODEX_AGENT_GIT_NAME="Codex Agent"
CODEX_AGENT_GIT_EMAIL=codex@your-org.tld

# OpenCode - Kimi instance (optional harness, disabled by default; uncomment to enable).
# OpenCode is provider-agnostic: the single `opencode` binary can drive many
# providers/models, so each logical agent is named after its model (opencode-kimi
# here). Add more instances by cloning this block with a new suffix, e.g.
# OPENCODE_GPT_AGENT_* -> agent "opencode-gpt". The model tag goes BEFORE _AGENT so
# the *_AGENT_GITLAB_TOKEN naming convention still resolves the agent name.
# Provider auth is NOT set here -- it comes from the pre-authenticated host config
# mounted in docker-compose.yml (run `opencode auth login` on the host first).
# OPENCODE_KIMI_AGENT_GITLAB_TOKEN=
# OPENCODE_KIMI_AGENT_GIT_NAME="OpenCode Kimi Agent"
# OPENCODE_KIMI_AGENT_GIT_EMAIL=opencode-kimi@your-org.tld
# OPENCODE_KIMI_MODEL=openrouter/moonshotai/kimi-k2.6
# Optional bind-mount path overrides for the host OpenCode config/data dirs:
# OPENCODE_CONFIG_PATH=$HOME/.config/opencode
# OPENCODE_DATA_PATH=$HOME/.local/share/opencode

# Goose - Gemma instance (optional harness, disabled by default; uncomment to enable).
# Goose is provider-agnostic like OpenCode: one `goose` binary drives many
# providers/models, so each logical agent is named after its model (goose-gemma
# here). Clone this block with a new suffix to add another, e.g. GOOSE_QWEN_AGENT_*
# -> agent "goose-qwen". The model tag goes BEFORE _AGENT so the
# *_AGENT_GITLAB_TOKEN naming convention still resolves the agent name.
#
# Configure Goose on the host first (`goose configure`) and confirm it works
# there -- provider, model, credentials, and extensions all come from the host
# config dir mounted in docker-compose.yml, so there is deliberately nothing here
# to restate them. If that config points a local model at loopback (llama.cpp,
# Ollama, LM Studio), the container rewrites it to reach the host; see
# app/goose_config.py. GOOSE_GEMMA_MODEL is passed to `goose run --model`; note
# that a llama.cpp server ignores it and serves whatever model is currently
# loaded, so against a local backend it is effectively a label for the run logs.
#
# The GitLab account does NOT need the harness prefix: the routes match on the
# username (`gemma`), while the agent slug (`goose-gemma`) resolves these vars.
# GOOSE_GEMMA_AGENT_GITLAB_TOKEN=
# GOOSE_GEMMA_AGENT_GIT_NAME="Gemma"
# GOOSE_GEMMA_AGENT_GIT_EMAIL=gemma@your-org.tld
# GOOSE_GEMMA_MODEL=local-llama-cpp
# Optional bind-mount path override for the host Goose config dir. Singular on
# purpose: every goose-* agent shares one binary and one host config.
# GOOSE_CONFIG_PATH=$HOME/.config/goose

# Grok Build (optional harness, disabled by default; uncomment to enable).
# Unlike OpenCode and Goose, one `grok` binary backs exactly one logical agent, so
# the GitLab username, the agent slug, and the env prefix are all plain `grok`.
#
# Authenticate on the host first (`grok login`) and confirm `grok` works there --
# credentials come from the host config dir (~/.grok/auth.json) mounted in
# docker-compose.yml, so there is deliberately no provider API key here. There is
# no XAI_API_KEY path; for a headless host with no browser, set GROK_DEPLOYMENT_KEY
# instead. GROK_MODEL is passed to `grok --model`; run `grok models` to list the
# ones your account can use.
# GROK_AGENT_GITLAB_TOKEN=
# GROK_AGENT_GIT_NAME="Grok Agent"
# GROK_AGENT_GIT_EMAIL=grok@your-org.tld
# GROK_MODEL=grok-4.5
# Optional bind-mount path override for the host Grok config dir:
# GROK_CONFIG_PATH=$HOME/.grok
# Optional: deployment key for headless hosts that cannot complete browser auth.
# GROK_DEPLOYMENT_KEY=

# Pi - Nemotron instance (optional harness, disabled by default; uncomment to enable).
# Pi is provider-agnostic like OpenCode/Goose: one `pi` binary drives many
# providers/models, so each logical agent is named after its model (pi-nemotron
# here). Clone this block with a new suffix to add another, e.g. PI_QWEN_AGENT_*
# -> agent "pi-qwen". The model tag goes BEFORE _AGENT so the *_AGENT_GITLAB_TOKEN
# naming convention still resolves the agent name.
#
# Configure Pi on the host first (`pi` interactive setup / provider login) and
# confirm it works there -- provider and credentials come from the host config dir
# (~/.pi/agent/auth.json + settings.json) mounted in docker-compose.yml, so there
# is deliberately no provider API key here. The default model below is served via
# OpenRouter (auth.json holds the `openrouter` key); PI_NEMOTRON_MODEL is passed to
# `pi --model`.
#
# Enabling Pi also bootstraps a pinned, user-local Node runtime at container boot
# (see scripts/install-pi.sh) -- the base image ships no Node, so this cost is paid
# only when a pi-* route is enabled and credentialed.
#
# The GitLab account does NOT need the harness prefix: the route matches on the
# username (`nemotron`), while the agent slug (`pi-nemotron`) resolves these vars.
# PI_NEMOTRON_AGENT_GITLAB_TOKEN=
# PI_NEMOTRON_AGENT_GIT_NAME="Pi Nemotron Agent"
# PI_NEMOTRON_AGENT_GIT_EMAIL=pi-nemotron@your-org.tld
# PI_NEMOTRON_MODEL=nvidia/nemotron-3-ultra-550b-a55b
# Keep webhook runs quiet and non-mutating: skip Pi's startup version check (which
# otherwise writes `lastChangelogVersion` into the mounted settings.json) and its
# telemetry / provider-attribution headers. Recommended defaults when Pi is enabled.
# PI_SKIP_VERSION_CHECK=1
# PI_TELEMETRY=0
# Optional bind-mount path override for the host Pi config dir. The narrow `agent`
# root is deliberate: it holds auth.json/settings.json/sessions, not all of ~/.pi.
# PI_CONFIG_PATH=$HOME/.pi/agent

# Custom agent example (uncomment and configure for your agent):
# QWEN_CODE_AGENT_GITLAB_TOKEN=
# QWEN_CODE_AGENT_GIT_NAME="Qwen Code Agent"
# QWEN_CODE_AGENT_GIT_EMAIL=qwen-code@your-org.tld
# QWEN_CODE_MODEL=qwen-coder-latest

# Recommended: map container user to host user (set to output of `id -u` / `id -g`)
# Required on Linux when host UID/GID differs from 1000 to avoid bind-mount permission errors
# Defaults to 1000 if unset (see docker-compose.yml)
LOCAL_UID=
LOCAL_GID=
